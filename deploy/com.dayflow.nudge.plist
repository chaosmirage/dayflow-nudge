<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Per-user LaunchAgent for the dayflow-nudge daemon: a TEMPLATE.
  deploy/install.sh renders it at install time: @@OWNED_DIR@@ becomes
  the owned install dir under the installing user's home, and each
  @@DFN_<NAME>@@ placeholder becomes the validated value from the
  user's .env or that knob's documented default. Do not hand-edit the
  rendered copy in ~/Library/LaunchAgents; edit .env (see
  .env-example) and re-run deploy/install.sh.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dayflow.nudge</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>-m</string>
		<string>dayflow_nudge</string>
	</array>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>WorkingDirectory</key>
	<string>@@OWNED_DIR@@</string>

	<key>StandardOutPath</key>
	<string>@@OWNED_DIR@@/logs/daemon.out.log</string>

	<key>StandardErrorPath</key>
	<string>@@OWNED_DIR@@/logs/daemon.err.log</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>DFN_DISABLE</key>
		<string>@@DFN_DISABLE@@</string>
		<key>DFN_NOTIFIER</key>
		<string>@@DFN_NOTIFIER@@</string>
		<key>DFN_POLL_SECONDS</key>
		<string>@@DFN_POLL_SECONDS@@</string>
		<key>DFN_STYLE</key>
		<string>@@DFN_STYLE@@</string>
		<key>DFN_DAYS</key>
		<string>@@DFN_DAYS@@</string>
		<key>DFN_QUIET_START</key>
		<string>@@DFN_QUIET_START@@</string>
		<key>DFN_QUIET_END</key>
		<string>@@DFN_QUIET_END@@</string>
		<key>DFN_DB_PATH</key>
		<string>@@DFN_DB_PATH@@</string>
	</dict>
</dict>
</plist>
